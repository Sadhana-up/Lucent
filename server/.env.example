# ─── Google Gemini API ───────────────────────────────────────
# Get API key from https://aistudio.google.com/apikey
# Used by the google-adk library for the LLM agent
GOOGLE_API_KEY=""

# ─── Rate Limiting ───────────────────────────────────────────
# Time window in seconds for rate limit buckets
RATE_LIMIT_WINDOW=60
# Maximum requests per window per client IP
RATE_LIMIT_MAX=30
# Internal API key for server-to-server auth (must match Next.js .env)
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=""
