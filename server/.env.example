# ─── Google Gemini API ───────────────────────────────────────
# Get API key from https://aistudio.google.com/apikey
# Used by the google-adk library for the LLM agent
GOOGLE_API_KEY=""

# ─── Rate Limiting ───────────────────────────────────────────
# Time window in seconds for rate limit buckets
RATE_LIMIT_WINDOW=60
# Maximum requests per window per client IP
RATE_LIMIT_MAX=30
# Internal API key for server-to-server auth (must match Next.js .env)
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=""

# ─── Database (read-only tool access) ────────────────────────
# Postgres DSN used by tools/product_search.py.
# Note: psycopg rejects the ?schema=public suffix Prisma uses, so omit it.
DATABASE_URL="postgresql://lucent:lucent_dev_password@localhost:5432/lucent_db"

# ─── ADK session persistence ─────────────────────────────────
# Optional. Overrides the database used to persist AI chat sessions.
# By default it reuses DATABASE_URL (converted to the psycopg async dialect).
# For a zero-dependency local dev setup you can point this at SQLite instead:
#   ADK_DB_URL="sqlite+aiosqlite:///./adk_sessions.db"
ADK_DB_URL=""

# Optional. Directory where uploaded chat images are persisted. Defaults to
# ./artifacts next to this file.
ARTIFACTS_DIR=""

