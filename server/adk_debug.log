{"parts":[{"function_response":{"id":"Qknajyui","name":"search_products","response":{"products":[{"id":"cmsbjhv020038jewc0balm7vl","title":"Ceramide Repair Lip Treatment","slug":"ceramide-repair-lip-treatment","description":"A deeply hydrating lip treatment with ceramides, shea butter, and hyaluronic acid that repairs dry, cracked lips and maintains moisture barrier.","price":14.99,"discount_price":null,"effective_price":14.99,"stock":160,"in_stock":true,"skin_type":"all","skin_concerns":"dry lips, chapping","ingredients":"Ceramides, Shea Butter, Hyaluronic Acid, Vitamin E, Jojoba Oil, Beeswax","usage_instructions":"Apply to lips as needed throughout the day. Can be used under lipstick or alone.","category_name":"Lip Care","seller_store_name":"Bare Glow","product_url":"/shop/ceramide-repair-lip-treatment","primary_image_url":"/seed/products/lipCare-1.jpg"},{"id":"cmsbjhv0a003gjewchr6jncpj","title":"Vitamin E Body Lotion","slug":"vitamin-e-body-lotion","description":"A nourishing full-body lotion enriched with vitamin E, shea butter, and coconut oil that provides 24-hour hydration for dry, rough skin.","price":18.99,"discount_price":15.99,"effective_price":15.99,"stock":175,"in_stock":true,"skin_type":"dry,normal","skin_concerns":"body dryness, rough texture","ingredients":"Vitamin E, Shea Butter, Coconut Oil, Glycerin, Aloe Vera, Oat Extract","usage_instructions":"Apply generously to body after shower while skin is still slightly damp. Massage until absorbed.","category_name":"Body Lotions","seller_store_name":"Bare Glow","product_url":"/shop/vitamin-e-body-lotion","primary_image_url":"/seed/products/bodyLotion-1.jpg"},{"id":"cmsbjhuzv0030jewcxst9wt7y","title":"Charcoal Detox Cleanser","slug":"charcoal-detox-cleanser","description":"A deep-cleansing charcoal cleanser that draws out impurities, unclogs pores, and leaves skin feeling fresh and purified without tightness.","price":21.99,"discount_price":18.99,"effective_price":18.99,"stock":105,"in_stock":true,"skin_ty