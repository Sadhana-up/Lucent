# ─── Docker Environment Variables ────────────────────────────
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
#
# IMPORTANT: In Docker, services communicate via service names (db, fastapi, nextjs)
# instead of localhost. The docker-compose.yml handles this mapping automatically.

# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=lucent
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=lucent_db

# ─── Better Auth ─────────────────────────────────────────────
# Secret for session signing (min 32 chars). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Base URL for Better Auth callbacks
BETTER_AUTH_URL="https://localhost"

# ─── Google OAuth ────────────────────────────────────────────
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Google Gemini API (FastAPI) ────────────────────────────
# Get API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# ─── Chat Backend ────────────────────────────────────────────
# Internal API key for server-to-server auth (must match in both services)
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=""

# ─── Rate Limiting (FastAPI) ─────────────────────────────────
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30

# ─── Resend Email ────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Lucent <noreply@lucentnepal.com>"
DEV_EMAIL_OVERRIDE=""

# ─── Trusted Origins (optional) ──────────────────────────────
TRUSTED_ORIGINS=""
