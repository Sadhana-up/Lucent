# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/lucent_db"

# ─── Better Auth ─────────────────────────────────────────────
# Secret for session signing (min 32 chars). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Base URL for Better Auth callbacks
BETTER_AUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────
# Public-facing app URL (defaults to BETTER_AUTH_URL if not set)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Display name used in emails and auth config
# APP_NAME="Dobaeni"

# ─── Google OAuth ────────────────────────────────────────────
# Get credentials from https://console.cloud.google.com/apis/credentials
# If not set, Google social login is disabled
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Chat Backend ────────────────────────────────────────────
# URL of the FastAPI server
CHAT_BACKEND_URL="http://localhost:8000"
# Public chat API path (bundled into client JS)
NEXT_PUBLIC_CHAT_API_BASE="/api/chat"

# ─── Resend Email ────────────────────────────────────────────
# Get API key from https://resend.com
RESEND_API_KEY=""
# Sender address (requires verified domain in production)
EMAIL_FROM="Dobaeni <onboarding@resend.dev>"
# In development, redirects ALL emails to this address (ignored in production)
DEV_EMAIL_OVERRIDE=""

# ─── Trusted Origins (optional) ──────────────────────────────
# Comma-separated list of additional trusted CORS origins
# TRUSTED_ORIGINS="https://example.com,https://www.example.com"
