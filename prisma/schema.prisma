generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth tables (Better Auth compatible) ─────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// canonical values: customer | seller | admin
  role          String    @default("customer")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  phone         String?
  phoneVerified DateTime?
  /// skin type: NORMAL | DRY | OILY | COMBINATION | SENSITIVE
  skinType      String?
  skinConcerns  String?   // comma-separated legacy; prefer SkinProfile
  onboardingCompleted Boolean? @default(false)

  sessions      Session[]
  accounts      Account[]
  sellerProfile SellerProfile?
  orders        Order[]
  reviews       Review[]
  addresses     Address[]
  cart          Cart?
  wishlists     Wishlist[]
  auditLogs     AuditLog[]    @relation("ActorLogs")
  recentlyViewed RecentlyViewed[]
  routines      Routine[]
  routineCompletions RoutineCompletion[]

  @@index([email])
  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ── Seller ───────────────────────────────────────────────────────────────────

model SellerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  storeName    String
  storeSlug    String   @unique
  bio          String?
  logo         String?
  banner       String?
  contactEmail String?
  phone        String?
  /// PENDING | APPROVED | REJECTED | SUSPENDED
  isVerified   Boolean  @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeSlug])
}

// ── Category ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

// ── Product ──────────────────────────────────────────────────────────────────

model Product {
  id                String    @id @default(cuid())
  sellerId          String
  categoryId        String?
  title             String
  slug              String    @unique
  description       String    @db.Text
  price             Decimal   @db.Decimal(12, 2)
  discountPrice     Decimal?  @db.Decimal(12, 2)
  stock             Int       @default(0)
  /// ACTIVE | DRAFT | OUT_OF_STOCK | ARCHIVED
  status            String    @default("ACTIVE")
  publishedAt       DateTime?
  deletedAt         DateTime? // soft delete / archive timestamp
  /// Legacy comma-string; normalise to ProductSkinType join
  skinType          String?
  skinConcerns      String?
  ingredients       String?   @db.Text
  usageInstructions String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  seller     SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlists  Wishlist[]
  recentlyViewed RecentlyViewed[]
  cartItems  CartItem[]
  routineSteps RoutineStep[]

  @@index([slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([status, categoryId, createdAt])
  @@index([status, sellerId, price])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  altText   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

// ── Wishlist ──────────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ── Address ──────────────────────────────────────────────────────────────────

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String   @default("Home")
  fullName    String
  phone       String
  address     String   @db.Text
  addressLine String?  @db.Text
  city        String
  state       String?
  district    String?
  province    String?
  country     String   @default("NP")
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Order ────────────────────────────────────────────────────────────────────

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  customerId      String
  /// PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | RETURN_REQUESTED | RETURNED | REFUNDED
  status          String    @default("PENDING")
  /// totals
  subtotal        Decimal   @db.Decimal(12, 2) @default(0)
  shippingFee     Decimal   @db.Decimal(12, 2) @default(0)
  discount        Decimal   @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal   @db.Decimal(12, 2)
  currency        String    @default("NPR")
  shippingAddress String    @db.Text
  contactPhone    String
  notes           String?   @db.Text
  /// khalti | cod
  paymentProvider String?
  /// UNPAID | PAID | FAILED | REFUNDED
  paymentStatus   String    @default("UNPAID")
  paymentRef      String?
  paymentTxnId    String?
  paidAt          DateTime?
  /// tracking
  trackingNumber  String?
  carrier         String?
  /// lifecycle timestamps
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  /// return / refund
  returnRequestedAt DateTime?
  returnReason    String?
  /// NONE | REQUESTED | APPROVED | PROCESSING | REFUNDED | REJECTED
  refundStatus    String    @default("NONE")
  refundReason    String?
  refundRequestedAt DateTime?
  refundedAt      DateTime?
  refundAmount    Decimal?  @db.Decimal(12, 2)
  /// inventory reservation
  reservationExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer User       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  events   OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  /// snapshot so order history survives product deletion/edit
  titleSnapshot String
  priceSnapshot Decimal  @db.Decimal(12, 2)
  imageSnapshot String?
  sellerIdSnapshot String?
  quantity      Int
  price         Decimal  @db.Decimal(12, 2)
  stockReserved Boolean  @default(false)
  createdAt     DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviews Review[]

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  actorId   String?
  actorRole String?
  event     String
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ── Review ───────────────────────────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderItemId String?
  rating      Int
  comment     String?  @db.Text
  /// true only when backed by an OrderItem
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// ── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([target])
}

// ── Daily routine builder ───────────────────────────────────────────────────

model Routine {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  /// profile snapshot used to build the routine
  skinType    String?
  concerns    String?  @db.Text
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps RoutineStep[]

  @@index([userId, updatedAt])
}

model RoutineStep {
  id            String   @id @default(cuid())
  routineId     String
  productId     String
  /// MORNING | EVENING
  timeOfDay     String   @default("MORNING")
  stepOrder     Int
  notes         String?  @db.Text
  /// snapshots keep the routine meaningful if a product is archived later
  titleSnapshot String
  imageSnapshot String?
  priceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  routine     Routine              @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  completions RoutineCompletion[]

  @@unique([routineId, productId, timeOfDay])
  @@index([routineId, stepOrder])
}

model RoutineCompletion {
  id          String   @id @default(cuid())
  stepId      String
  userId      String
  /// UTC calendar day (YYYY-MM-DD) — one check-off per step per day
  day         String
  completedAt DateTime @default(now())

  step RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stepId, day])
  @@index([userId, day])
}
